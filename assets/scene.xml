<mujoco model="robot_arm_tray_scene">
  <compiler angle="radian" meshdir="robot/assets" autolimits="true"/>

  <option integrator="implicitfast" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.55" rgb2="0.05 0.05 0.08" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.28 0.32" rgb2="0.15 0.17 0.20"
      markrgb="0.7 0.7 0.7" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.15"/>
    <material name="table_material" rgba="0.55 0.45 0.35 1" specular="0.2" shininess="0.1"/>
    <material name="cylinder_material" rgba="0.85 0.35 0.15 1" specular="0.1" shininess="0.05"/>
    <material name="tray_material" rgba="0.15 0.35 0.75 1" specular="0.3" shininess="0.2"/>
    <material name="tray_rim" rgba="0.1 0.25 0.55 1"/>
  </asset>

  <include file="robot/panda.xml"/>

  <worldbody>
    <include file="cylinder/soft_cylinder.xml"/>
    <include file="tray/rectangular_tray.xml"/>

    <light pos="0.3 0.2 1.2" dir="-0.2 -0.1 -1" directional="true" diffuse="0.9 0.9 0.85"/>
    <light pos="-0.4 0.5 1.0" dir="0.3 -0.2 -1" directional="true" diffuse="0.5 0.5 0.55"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Work table: top surface at z = 0.40 m -->
    <body name="work_table" pos="0.5 0.15 0.375">
      <geom name="table_top" type="box" size="0.35 0.30 0.025" material="table_material" friction="1.0 0.02 0.002"/>
    </body>

    <!-- Offset in +X so the Panda arm does not occlude the cylinder beacon. -->
    <camera name="overhead_rgb" pos="0.72 0.15 1.45" xyaxes="1 0 0 0 1 0" fovy="40"/>
    <camera name="demo_camera" pos="0.15 0.55 0.75" xyaxes="0.95 0 0.31 0 1 0" fovy="45"/>
  </worldbody>
</mujoco>
